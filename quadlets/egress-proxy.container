[Unit]
Description=Allowlist proxy: the mail bridge may reach Proton, news-fetch its named hosts, nothing else

[Container]
ContainerName=egress-proxy
# Canonical's Squid image; pin a current tag from hub.docker.com/r/ubuntu/squid
Image=docker.io/ubuntu/squid:6.6-24.04_beta
Network=egress.network
Network=agent.network
# news-fetch reaches Squid here; squid.conf tells it apart by this network's subnet.
Network=fetch.network
Volume=%h/agent/egress-proxy/squid.conf:/etc/squid/squid.conf:ro,Z
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=default.target
